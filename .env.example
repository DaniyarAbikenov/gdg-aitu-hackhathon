# Optional: Docker works with defaults and no cloud credentials.
CAREER_PORT=8080
CAREER_DB_PASSWORD=career-local-only
CAREER_PROVIDER=unconfigured
CAREER_SECURE_COOKIE=false
CAREER_SESSION_HOURS=24
CAREER_ANALYSIS_PER_HOUR=30
# Set provider=gemini only when you intend to send reviewed fields + job text to Google.
CAREER_GEMINI_API_KEY=
CAREER_GEMINI_MODEL=

# Optional Google Identity Services web client (public ID, not a secret)
CAREER_GOOGLE_CLIENT_ID=

# Set CAREER_PROVIDER=openai after configuring both values. Never commit your key.
CAREER_OPENAI_API_KEY=
CAREER_OPENAI_MODEL=

# Production hides global technical status banners.
CAREER_ENVIRONMENT=production
# Provision an allowlisted account with: python -m app.manage EMAIL
CAREER_ADMIN_EMAILS=
# Voice requires OpenAI credentials plus independently configured models.
CAREER_OPENAI_REALTIME_MODEL=
CAREER_OPENAI_TRANSCRIPTION_MODEL=

# Provider prices in USD per million tokens, for the admin cost estimate (0 = tokens only).
CAREER_AI_INPUT_USD_PER_MILLION=0
CAREER_AI_OUTPUT_USD_PER_MILLION=0

# Observability. Logs are JSON lines with a request id (CAREER_LOG_FORMAT=text for local reading).
CAREER_LOG_LEVEL=INFO
# Error reporting (Sentry or a compatible service). Request bodies and personal data are not sent.
CAREER_SENTRY_DSN=
# OpenTelemetry traces over OTLP/HTTP for API, worker, PostgreSQL, Redis and provider calls.
CAREER_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Email for password recovery and address confirmation. Docker sends it to the bundled
# Mailpit catcher (http://127.0.0.1:8025) unless you set a real server, for example
# CAREER_SMTP_URL=smtp+starttls://user:password@smtp.example.com:587
# CAREER_MAIL_FROM=Career Studio <no-reply@example.com>
# CAREER_PUBLIC_URL=https://career.example.com
