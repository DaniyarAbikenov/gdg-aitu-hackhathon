# Optional: Docker works with defaults and no cloud credentials.
CAREER_PORT=8080
CAREER_DB_PASSWORD=career-local-only
CAREER_PROVIDER=unconfigured
CAREER_SECURE_COOKIE=false
CAREER_SESSION_HOURS=24
CAREER_ANALYSIS_PER_HOUR=30
# Set provider=gemini only when you intend to send reviewed fields + job text to Google.
CAREER_GEMINI_API_KEY=
CAREER_GEMINI_MODEL=

# Optional Google Identity Services web client (public ID, not a secret)
CAREER_GOOGLE_CLIENT_ID=

# Set CAREER_PROVIDER=openai after configuring both values. Never commit your key.
CAREER_OPENAI_API_KEY=
CAREER_OPENAI_MODEL=

# Production hides global technical status banners.
CAREER_ENVIRONMENT=production
# Provision an allowlisted account with: python -m app.manage EMAIL
CAREER_ADMIN_EMAILS=
# Voice requires OpenAI credentials plus independently configured models.
CAREER_OPENAI_REALTIME_MODEL=
CAREER_OPENAI_TRANSCRIPTION_MODEL=
