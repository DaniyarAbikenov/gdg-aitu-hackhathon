# Copy to deploy/.env on the server and fill in. Never commit the filled file.
CAREER_DOMAIN=career.example.com
# Release tag published by .github/workflows/release.yml, without the leading "v".
CAREER_VERSION=0.5.0
CAREER_IMAGE_OWNER=daniyarabikenov
CAREER_WEB_WORKERS=2

# Generate with: openssl rand -base64 32
CAREER_DB_PASSWORD=

# Public demo: the rule-based provider is labelled as a test provider in the UI.
# Switch to openai or gemini only with your own key and a spending limit.
CAREER_PROVIDER=local
CAREER_OPENAI_API_KEY=
CAREER_OPENAI_MODEL=
CAREER_GEMINI_API_KEY=
CAREER_GEMINI_MODEL=
CAREER_OPENAI_REALTIME_MODEL=
CAREER_OPENAI_TRANSCRIPTION_MODEL=

CAREER_GOOGLE_CLIENT_ID=
CAREER_ADMIN_EMAILS=
CAREER_ENVIRONMENT=production
CAREER_SESSION_HOURS=24
CAREER_ANALYSIS_PER_HOUR=30
CAREER_SESSION_CREATIONS_PER_HOUR=30
CAREER_AUTH_PER_15_MINUTES=15

# Optional email for password recovery and address confirmation, e.g.
# smtp+starttls://user:password@smtp.example.com:587 or smtps://...:465
CAREER_SMTP_URL=
CAREER_MAIL_FROM=Career Studio <no-reply@career.example.com>

# Provider prices in USD per million tokens, for the admin cost estimate (0 = tokens only).
CAREER_AI_INPUT_USD_PER_MILLION=0
CAREER_AI_OUTPUT_USD_PER_MILLION=0

# Optional observability (docs/operations.md#observability).
CAREER_SENTRY_DSN=
CAREER_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
